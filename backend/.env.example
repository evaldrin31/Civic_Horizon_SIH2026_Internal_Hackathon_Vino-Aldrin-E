# PostgreSQL configuration for local development
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aip
DATABASE_ECHO=false

# Application
APP_NAME="Accessibility Intelligence Platform"
APP_VERSION=0.1.0
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
