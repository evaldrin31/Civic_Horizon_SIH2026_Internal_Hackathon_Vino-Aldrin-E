# Accessibility Intelligence Platform - Frontend Environment

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps Configuration (Required for interactive map)
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Map fallback settings
# Set to "true" to disable map and use list-only view
NEXT_PUBLIC_DISABLE_MAP=false

# Optional: Default map center (latitude, longitude)
# Defaults to center of India: 20.5937, 78.9629
NEXT_PUBLIC_DEFAULT_MAP_LAT=20.5937
NEXT_PUBLIC_DEFAULT_MAP_LNG=78.9629

# Optional: Default map zoom level
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=5

# Optional: Alternative Map Provider (not currently implemented)
# Options: google (default), mapbox, leaflet
NEXT_PUBLIC_MAP_PROVIDER=google
